{
  "name": "card-game-platform-backend",
  "version": "1.0.0",
  "description": "Backend for card game platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --verbose",
    "seed": "psql postgresql://lotannaezeuko@localhost:5432/card_game_db -f db/seed.sql",
    "seed:decks": "node db/seed-decks.js",
    "db:reset": "psql postgresql://lotannaezeuko@localhost:5432/card_game_db -f db/reset.sql",
    "db:fresh": "npm run db:reset && npm run seed && npm run seed:decks"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.0.3"
  }
}
